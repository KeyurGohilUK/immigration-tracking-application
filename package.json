{
  "name": "urbanfox-ilr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --write tests/e2e/app-shell.spec.ts && git diff -- tests/e2e/app-shell.spec.ts && exit 1",
    "typecheck": "tsc --noEmit",
    "check:release": "node scripts/check-release-version.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run lint:frontend && npm run typecheck && npm run check:release && npm run test:unit && npm run build",
    "lint:frontend": "node scripts/check-frontend-standards.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
